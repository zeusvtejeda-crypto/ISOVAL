# ═══════════════════════════════════════════════════════════════
#  CONFIGURACIÓN — copia este archivo como ".env" y llena los datos.
#  (El archivo .env NO se sube a git; guarda tus claves en secreto.)
# ═══════════════════════════════════════════════════════════════

# ── Cerebro: qué IA redacta las respuestas ───────────────────────
# "gemini"    -> GRATIS, sin tarjeta (límite de peticiones por minuto).
# "anthropic" -> Claude, de paga por uso, mejor calidad.
AI_PROVIDER=gemini

# Gemini: consíguela GRATIS en https://aistudio.google.com/apikey
# (inicia sesión con una cuenta de Google, "Create API key", sin tarjeta)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Claude (solo si AI_PROVIDER=anthropic):
# Consíguela en https://console.anthropic.com -> API Keys (requiere
# agregar crédito en Billing antes de poder usarla)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────
# Token que TÚ inventas (cualquier texto) y pones IGUAL en Meta al
# configurar el webhook. Ej: "labaa-2026-secreto"
WHATSAPP_VERIFY_TOKEN=cambia-esto

# Token de acceso GENERAL (empieza con EAA...). Sirve como respaldo
# si solo tienes un negocio conectado, o si todos comparten la MISMA
# app de Meta.
WHATSAPP_TOKEN=

# Versión de la Graph API (normalmente no la cambias)
GRAPH_VERSION=v21.0

# ── Asignación de números a negocios ─────────────────────────────
# El "phone_number_id" que Meta le da a CADA número de WhatsApp.
# Lo copias del panel de Meta (WhatsApp > API Setup).
PHONE_ID_CAMAS=
PHONE_ID_FITHOUSE=
PHONE_ID_INMOBILIARIA=
PHONE_ID_ISOVAL=

# Si cada negocio vive en una APP DE META distinta (cada una con su
# propio token), pon aquí el token específico de cada uno. Si un
# negocio no tiene el suyo, usa WHATSAPP_TOKEN de arriba como respaldo.
WHATSAPP_TOKEN_CAMAS=
WHATSAPP_TOKEN_ISOVAL=

# Si por ahora usas UN SOLO número para probar, pon aquí el id del
# negocio que debe atenderlo (ej: camas). Déjalo vacío cuando ya
# tengas los números asignados arriba.
DEFAULT_BUSINESS=

# ── Aviso a una persona real ─────────────────────────────────────
# TU celular, en formato internacional y SOLO DÍGITOS (sin +, sin
# espacios). Ej: 5213111216033. Ahí te llega un WhatsApp cuando un
# cliente pide hablar con alguien, se queja o pide factura.
# Desde ese mismo número puedes mandarle órdenes al asistente:
#   pausa 3339998877   -> deja de contestarle a ese cliente
#   sigue 3339998877   -> vuelve a atenderlo
#   estado             -> te dice si todo está funcionando
WHATSAPP_ADMIN=

# Si cada negocio le avisa a una persona distinta, ponlo aquí. Si lo
# dejas vacío, todos le avisan a WHATSAPP_ADMIN.
AVISAR_A_CAMAS=
AVISAR_A_ISOVAL=
AVISAR_A_FITHOUSE=
AVISAR_A_INMOBILIARIA=

# Cuántas horas se queda callado el asistente en una conversación
# después de pasarla a una persona (o de que tú contestes a mano).
PAUSA_HORAS=3

# IMPORTANTE (regla de Meta): solo puedes mandar texto libre a quien
# te escribió en las últimas 24 h. Como tú casi nunca le escribes al
# número del negocio, el aviso a TU celular es justo el que más fácil
# se cae. Para que no se pierda, crea una plantilla en Meta (WhatsApp
# Manager > Plantillas de mensajes) y pon aquí su nombre. Ver README.
PLANTILLA_AVISO=
PLANTILLA_IDIOMA=es_MX

# ── Memoria que sobrevive a los reinicios ────────────────────────
# En Vercel el servidor se apaga y se prende todo el tiempo, así que
# sin esto el asistente olvida el hilo a media conversación. Crea un
# Redis gratis en https://upstash.com (o conecta Vercel KV desde el
# panel de Vercel, que rellena estas variables solo) y pega los datos.
# Si lo dejas vacío el asistente funciona igual, pero con amnesia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Puerto del servidor (tu hosting suele fijarlo solo)
PORT=3000
