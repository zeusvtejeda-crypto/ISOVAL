# ═══════════════════════════════════════════════════════════════
#  CONFIGURACIÓN — copia este archivo como ".env" y llena los datos.
#  (El archivo .env NO se sube a git; guarda tus claves en secreto.)
# ═══════════════════════════════════════════════════════════════

# ── Cerebro: Claude (Anthropic) ──────────────────────────────────
# Consíguela en https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=

# Modelo de Claude (déjalo así salvo que quieras cambiarlo)
ANTHROPIC_MODEL=claude-sonnet-5

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────
# Token que TÚ inventas (cualquier texto) y pones IGUAL en Meta al
# configurar el webhook. Ej: "labaa-2026-secreto"
WHATSAPP_VERIFY_TOKEN=cambia-esto

# Token de acceso de tu app de Meta (empieza con EAAG...).
WHATSAPP_TOKEN=

# Versión de la Graph API (normalmente no la cambias)
GRAPH_VERSION=v21.0

# ── Asignación de números a negocios ─────────────────────────────
# El "phone_number_id" que Meta le da a CADA número de WhatsApp.
# Lo copias del panel de Meta (WhatsApp > API Setup).
PHONE_ID_CAMAS=
PHONE_ID_FITHOUSE=
PHONE_ID_INMOBILIARIA=

# Si por ahora usas UN SOLO número para probar, pon aquí el id del
# negocio que debe atenderlo (ej: camas). Déjalo vacío cuando ya
# tengas los números asignados arriba.
DEFAULT_BUSINESS=

# Puerto del servidor (tu hosting suele fijarlo solo)
PORT=3000
