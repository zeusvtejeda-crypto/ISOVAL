/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/index.html
  Cache-Control: no-cache
/core.js
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/fonts.css
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.webmanifest
  Content-Type: application/manifest+json
