{
  "name": "tubarberia",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TuBarbería — SaaS de reservas y gestión para barberías (Cloudflare Pages + D1).",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "migration": "node scripts/gen-migration.mjs",
