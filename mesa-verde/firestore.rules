rules_version = '2';
// ═══════════════════════════════════════════════════════════════
//  REGLAS DE FIRESTORE — Mesa Verde · pedidos de comida
//  Pega este archivo completo en Firebase → Firestore Database → Rules
//  y publica. Cambia los correos de ADMINS por los tuyos.
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos con acceso al panel (tú y el dueño del negocio).
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'zeus@ejemplo.com',      // ← cambia por tu correo
          'dueno@ejemplo.com'      // ← cambia por el correo del dueño
        ];
    }

    function texto(v, max) { return v is string && v.size() <= max; }

    // Un pedido válido: solo los campos esperados, tamaños acotados,
    // de 1 a 20 platillos y siempre nace en estado "nuevo".
    function pedidoValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','creado','fechaEntrega','horario','nombre','telefono','universidad','facultad','salon','items','alergias','alergiasTexto','notas','estado','total','origen'])
        && d.keys().hasAll(['id','creado','fechaEntrega','horario','nombre','telefono','universidad','salon','items','estado'])
        && texto(d.id, 24) && d.id == request.resource.id
        && texto(d.creado, 40)
        && texto(d.fechaEntrega, 10) && d.fechaEntrega.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && texto(d.horario, 8)
        && texto(d.nombre, 60) && texto(d.telefono, 13)
        && texto(d.universidad, 80) && texto(d.salon, 40)
        && (!('facultad' in d) || texto(d.facultad, 80))
        && (!('alergiasTexto' in d) || texto(d.alergiasTexto, 160))
        && (!('notas' in d) || texto(d.notas, 300))
        && (!('alergias' in d) || (d.alergias is list && d.alergias.size() <= 12))
        && (!('origen' in d) || texto(d.origen, 10))
        && (!('total' in d) || d.total == null || d.total is number)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 20
        && d.estado == 'nuevo';
    }

    // Configuración y menú: los ve cualquiera, los edita solo un admin.
    match /config/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /platillos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Pedidos: cualquiera puede crear uno (el cliente no inicia sesión),
    // pero solo los admins pueden verlos, actualizarlos o borrarlos.
    match /pedidos/{id} {
      allow create: if pedidoValido();
      allow read, update, delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
